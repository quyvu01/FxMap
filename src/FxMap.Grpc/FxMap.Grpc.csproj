<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <Version>5.1.1</Version>
        <Authors>Quy Vu</Authors>
        <PackageId>FxMap.gRPC</PackageId>
        <Description>FxMap extension. Use gRPC as Data transporting</Description>
        <PackageTags>FxMap;mappable;open-source;gRPC;microservices;distributed-systems;data-mapping;dto;dotnet;csharp</PackageTags>
        <RepositoryUrl>https://github.com/quyvu01/FxMap</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://fxmapper.net</PackageProjectUrl>
        <PackageIcon>FxMap.png</PackageIcon>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" Version="[2.51.0, )"/>
        <PackageReference Include="Grpc.Core" Version="[2.46.6, )"/>
        <PackageReference Include="Grpc.Net.Client" Version="[2.51.0, )"/>
        <!-- Build-time only: the protoc bundled with the transitive Grpc.Tools 2.51.0 is x64-only on macOS -->
        <PackageReference Include="Grpc.Tools" Version="2.85.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Protobuf Include="fxMap.proto" Access="Internal">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Protobuf>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="FxMap.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FxMap\FxMap.csproj"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="NUGET.md" Pack="true" PackagePath="\README.md"/>
        <None Include="..\..\FxMap.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>FxMap.png</Link>
        </None>
    </ItemGroup>
</Project>
