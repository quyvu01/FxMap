<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <Version>5.0.0</Version>
        <Authors>Quy Vu</Authors>
        <PackageId>FxMap.EntityFrameworkCore</PackageId>
        <Description>FxMap extension. Use EntityFramework as Data Querying</Description>
        <PackageTags>FxMap;mappable;open-source;entity-framework;ORM;microservices;distributed-systems;data-mapping;dto;dotnet;csharp</PackageTags>
        <RepositoryUrl>https://github.com/quyvu01/FxMap</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://fxmapper.net</PackageProjectUrl>
        <PackageIcon>FxMap.png</PackageIcon>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[8.0.0, )" />
        <!-- EF Core 8.0.0 brings 8.0.0 of this package, which has a known vulnerability (GHSA-qj66-m88j-hmgj): 8.0.1 is the fix -->
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="[8.0.1, )" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\FxMap.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>FxMap.png</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FxMap\FxMap.csproj"/>
        <None Include="NUGET.md" Pack="true" PackagePath="\README.md"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
