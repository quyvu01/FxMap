<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <Version>5.0.0</Version>
        <Authors>Quy Vu</Authors>
        <PackageId>FxMap.MongoDb</PackageId>
        <Description>FxMap extension. Use MongoDb as Data Querying</Description>
        <PackageTags>FxMap;mappable;open-source;mongoDb;ORM;microservices;distributed-systems;data-mapping;dto;dotnet;csharp</PackageTags>
        <RepositoryUrl>https://github.com/quyvu01/FxMap</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://fxmapper.net</PackageProjectUrl>
        <PackageIcon>FxMap.png</PackageIcon>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\FxMap.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>FxMap.png</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FxMap\FxMap.csproj"/>
        <None Include="NUGET.md" Pack="true" PackagePath="\README.md"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 3.9.0 is the first version that depends on SharpCompress 0.48.1 and Snappier 1.3.1, the fixes of GHSA-6c8g-7p36-r338 and GHSA-pggp-6c3x-2xmx -->
        <PackageReference Include="MongoDB.Driver" Version="[3.9.0, )"/>
    </ItemGroup>
</Project>
