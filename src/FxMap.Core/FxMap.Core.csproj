<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <Version>5.1.1</Version>
        <Authors>Quy Vu</Authors>
        <PackageId>FxMap.Core</PackageId>
        <RootNamespace>FxMap</RootNamespace>
        <Description>The engine of FxMap without a dependency injection container: profiles, the expression language, the distributed mapper and FxMapBuilder. Use the FxMap package for services.AddFxMap(...).</Description>
        <PackageTags>FxMap;mappable;open-source;microservices;distributed-systems;data-mapping;dto;dotnet;csharp</PackageTags>
        <RepositoryUrl>https://github.com/quyvu01/FxMap</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://fxmapper.net</PackageProjectUrl>
        <PackageIcon>FxMap.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <!-- No Microsoft.Extensions.DependencyInjection here: the container integration is the FxMap package. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[8.0.0, )"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FxMap" />
        <InternalsVisibleTo Include="FxMap.Tests" />
        <InternalsVisibleTo Include="FxMap.Benchmark" />
        <InternalsVisibleTo Include="FxMap.EntityFrameworkCore" />
        <InternalsVisibleTo Include="FxMap.MongoDb" />
        <InternalsVisibleTo Include="FxMap.HotChocolate" />
        <InternalsVisibleTo Include="FxMap.Aws.Sqs" />
        <InternalsVisibleTo Include="FxMap.Azure.ServiceBus" />
        <InternalsVisibleTo Include="FxMap.Grpc" />
        <InternalsVisibleTo Include="FxMap.Kafka" />
        <InternalsVisibleTo Include="FxMap.Nats" />
        <InternalsVisibleTo Include="FxMap.RabbitMq" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\FxMap.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>FxMap.png</Link>
        </None>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="NUGET.md" Pack="true" PackagePath="\README.md"/>
    </ItemGroup>

</Project>
